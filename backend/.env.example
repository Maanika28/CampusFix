# CampusFix Environment Configuration

# Django Settings
SECRET_KEY=django-insecure-campusfix-smart-system-secret-key-2026-prod-ready
DEBUG=True
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'postgres'
DB_ENGINE=sqlite

# PostgreSQL Configuration (used when DB_ENGINE=postgres)
DB_NAME=campusfix_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cloudinary Storage Configuration (Optional, falls back to local media/ if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Settings (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@campusfix.edu
